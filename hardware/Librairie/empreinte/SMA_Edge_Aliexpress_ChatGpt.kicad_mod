(footprint "SMA_EDGE_5P08"
  (version 20211014)
  (generator pcbnew)

  (descr "SMA edge mount connector 5.08mm GND spacing (generic Chinese type)")

  (attr through_hole)

  (fp_line (start -3 0) (end 3 0) (layer "Edge.Cuts") (width 0.1))

  (fp_text reference "J?" (at 0 -4) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_text value "SMA_EDGE_5P08" (at 0 4) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ; Center pin (50 ohm line)
  (pad "1" thru_hole circle
    (at 0 0)
    (size 1.2 1.2)
    (drill 0.8)
    (layers *.Cu *.Mask)
  )

  ; Ground pads (5.08 mm spacing)
  (pad "2" thru_hole circle
    (at -2.54 0)
    (size 2 2)
    (drill 1.0)
    (layers *.Cu *.Mask)
  )

  (pad "3" thru_hole circle
    (at 2.54 0)
    (size 2 2)
    (drill 1.0)
    (layers *.Cu *.Mask)
  )

  ; Keepout suggestion
  (zone (net 0) (net_name "")
    (layers "F.Cu" "B.Cu")
    (tstamp 0)
  )
)